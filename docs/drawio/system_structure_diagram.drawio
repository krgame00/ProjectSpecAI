        <!-- Google Gemini Cloud AI -->
        <mxCell id="ai_gemini" value="บริการคลาวด์ AI&#xa;(Google Gemini API)&#xa;• LLM Engine&#xa;• วิเคราะห์คำแนะนำสเปก" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="980" y="140" width="160" height="110" as="geometry" />
        </mxCell>


