          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin UI to Web Server -->
        <mxCell id="flow_admin_server" value="HTTPS / REST API (JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui_admin" target="server_web">
