  <diagram id="BOWihtSKedjwbVZvfZT4" name="หน้า-2">
    <mxGraphModel dx="1664" dy="921" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% กำหนด Actors ทั้ง 3 ตัว\n    User((🧑‍💻 ผู้ใช้งานทั่วไป))\n    AI((🤖 แชตบอตอัจฉริยะ))\n    Admin((👨‍🔧 ผู้ดูแลระบบ))\n\n    %% ขอบเขตของระบบ (System Boundary)\n    subgraph System[ระบบจัดสเปคคอมพิวเตอร์ PCSpec]\n        direction TB\n        \n        %% Use Cases ฝั่งผู้ใช้งานทั่วไป\n        UC1([เลือกอุปกรณ์คอมพิวเตอร์])\n        UC2([ตรวจสอบราคา])\n        UC3([สนทนากับแชตบอตเพื่อขอคำแนะนำสเปค])\n        UC4([บันทึก/สั่งพิมพ์ใบเสนอราคา])\n        \n        %% Use Cases ฝั่งแชตบอตอัจฉริยะ\n        UC5([รับข้อมูลความต้องการ])\n        UC6([วิเคราะห์ความเข้ากันได้ของอุปกรณ์])\n        UC7([นำเสนอสเปคตามงบประมาณ])\n        \n        %% Use Cases ฝั่งผู้ดูแลระบบ\n        UC8([จัดการข้อมูลอุปกรณ์คอมพิวเตอร์ \\n เพิ่ม/ลบ/แก้ไข])\n    end\n\n    %% โยงเส้นความสัมพันธ์จาก User ไปหา Use Case\n    User --&gt; UC1\n    User --&gt; UC2\n    User --&gt; UC3\n    User --&gt; UC4\n\n    %% โยงเส้นความสัมพันธ์จาก AI Chatbot ไปหา Use Case\n    AI --&gt; UC5\n    AI --&gt; UC6\n    AI --&gt; UC7\n\n    %% โยงเส้นความสัมพันธ์จาก Admin ไปหา Use Case\n    Admin --&gt; UC8\n\n    %% โยงความสัมพันธ์ระหว่างการแชตของ User กับการรับข้อมูลของ AI\n    UC3 -.-&gt;|ส่งข้อมูลให้| UC5\n    UC7 -.-&gt;|แสดงผลให้| User\n\n    %% ตกแต่งสีสันให้สวยงาม\n    classDef default fill:#ffffff,stroke:#333,stroke-width:1.5px;\n    style System fill:#f8f9fa,stroke:#adb5bd,stroke-width:2px,stroke-dasharray: 5 5;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OPZ5X1FypB6SE7KS_2Qo-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontColor=#000000;" vertex="1">
            <mxGeometry height="620" width="1666" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Smart PC Specification and Price Estimation System with AI Spec Chatbot&lt;div&gt;ForgeLabs&lt;/div&gt;" mermaidId="n:System" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;verticalAlign=top;fillColor=#f8f9fa;strokeColor=#adb5bd;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;dashed=1;dashPattern=5 5;fixDash=1;" mermaidBaseValue="ระบบจัดสเปคคอมพิวเตอร์ PCSpec" id="OPZ5X1FypB6SE7KS_2Qo-2">
          <mxCell parent="OPZ5X1FypB6SE7KS_2Qo-1" style="html=1;whiteSpace=wrap;strokeWidth=2;verticalAlign=top;fillColor=#f8f9fa;strokeColor=#adb5bd;fontColor=#000000;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;dashed=1;dashPattern=5 5;fixDash=1;" vertex="1">
