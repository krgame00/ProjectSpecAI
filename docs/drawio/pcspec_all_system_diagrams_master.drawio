          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend Prep -> Gemini -->
        <mxCell id="e9" edge="1" parent="1" source="act_ai_be" target="act_gemini" style="strokeColor=#000000;strokeWidth=1.5;endArrow=open;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
