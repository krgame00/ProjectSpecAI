  <diagram id="diagram_layered_arch_thai" name="4.1.3 สถาปัตยกรรมโครงสร้างระบบ (เข้าใจง่าย)">
    <mxGraphModel dx="1141" dy="944" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
